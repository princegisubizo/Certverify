# ---- Core ----
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (create a DB user with readWrite on this DB only)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/certverify?retryWrites=true&w=majority
# At least 32 random characters: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_SAMESITE=lax

# ---- URLs ----
# Where the React app is served (CORS + iframe embedding allow-list)
CLIENT_URL=http://localhost:5173
# Base URL encoded in QR codes. Set explicitly to the permanent HTTPS app domain in production.
PUBLIC_APP_URL=http://localhost:5173
# Only needed if the API lives on a different domain than the front end
API_BASE_URL=
# Serve client/dist from this server (recommended: one domain for everything)
SERVE_CLIENT=true
TRUST_PROXY=

# ---- Institution / policy ----
INSTITUTION_NAME=Your Institution
MAX_UPLOAD_MB=10
ALLOW_PUBLIC_DOWNLOAD=true
ALLOW_PUBLIC_PDF_WHEN_REVOKED=true
# QR error correction: L, M, Q or H
QR_ERROR_CORRECTION=Q
# The QR is fit into a clear square in the selected page corner. Dimensions are millimetres.
# PDF_QR_SIZE_MM is the maximum QR size; PDFs need at least 18 mm of clear space.
# PDF_QR_PAGE is one-based.
PDF_QR_PAGE=1
PDF_QR_SIZE_MM=28
PDF_QR_MARGIN_MM=10
PDF_QR_CORNER=bottom-right

# ---- PDF storage: local | s3 ----
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage
# S3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO...). Keep the bucket PRIVATE.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
